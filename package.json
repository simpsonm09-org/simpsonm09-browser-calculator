{
  "name": "browser-calculator",
  "version": "0.1.0",
  "private": true,
  "description": "A browser calculator served by Fastify: a safe arithmetic evaluator and a stateless form.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "spec": "node scripts/write-openapi.mjs",
    "verify": "npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "^9.9.5",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "1.65.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "fast-uri@^3": "3.1.9",
    "fast-uri@^4": "4.2.3"
  }
}
